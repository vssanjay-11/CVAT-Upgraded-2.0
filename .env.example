# ============================================================
# ROOTS Platform - Production Environment Variables Template
# Copy to .env in your secure deployment environment.
# NEVER commit .env to version control.
# ============================================================

# 1. Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/auth/google/callback

# 2. Session & Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate-a-secure-32-byte-hex-random-key
SESSION_DURATION_SECONDS=604800

# 3. Initial Administrator Bootstrap Email
# The user whose authenticated Google email matches this becomes ADMIN automatically on first login.
ADMIN_GOOGLE_EMAIL=sanjay@roots-industries.com

# 3b. Auth Mode
# GLOBAL_ADMIN  — ALL Google-authenticated users receive ADMIN role (recommended for trusted internal team)
# SINGLE_ADMIN  — Only ADMIN_GOOGLE_EMAIL is ADMIN; all other Google users are USER
AUTH_MODE=GLOBAL_ADMIN

# 4. Google Drive Dataset Storage
# Target Production Folder ID (Pre-configured):
GOOGLE_DRIVE_ROOT_FOLDER_ID=1NRmlelgPqA61sEpK6AyyYg_eSIE-LdZD

# Service Account Credentials (either path to JSON file OR inline JSON string)
GOOGLE_SERVICE_ACCOUNT_PATH=/etc/secrets/google-service-account.json
# Or inline JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# 5. Persistent Multi-User Database
# Persistent PostgreSQL connection string (Supabase, Neon, GCP Cloud SQL, or AWS RDS)
DATABASE_URL=postgresql://cvat_user:secure_password@db.roots-platform.internal:5432/cvat_production

# 6. Decoupled AI Inference Service
# URL of persistent GPU inference worker (Torch/Ultralytics YOLO11s instance segmentation)
AI_INFERENCE_SERVICE_URL=https://yolo-inference.roots-cvat.internal
AI_INFERENCE_API_KEY=optional-secure-bearer-token

# 7. Server & Network Configuration
HOST=0.0.0.0
PORT=7000
NODE_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1,your-vercel-domain.vercel.app
